+/*
+ * The window settled on a new size. The library calls this on its UI thread, so the
+ * mode list is replaced on the BH, under the BQL, not here.
+ */
+static void apple_gfx_window_resize_cb(void *ctx, uint16_t width, uint16_t height)
+{
+    AppleGFXEvent *event = apple_gfx_event_new(ctx, APPLE_GFX_EVENT_RESIZE);
+
+    event->resize.width = width;
+    event->resize.height = height;
+    apple_gfx_event_push(event);
+}
+
+/* One mode, the size the window asked for. The guest switches to it. */
+static void apple_gfx_apply_resize(AppleGFXDisplay *d, uint16_t width,
+                                   uint16_t height)
+{
+    RvgDisplayMode mode = {
+        .width = width,
+        .height = height,
+        .refresh_rate_hz = 60,
+    };
+
+    if (!d->pgdisp || width < 640 || height < 480) {
+        return;
+    }
+    rvg_display_set_modes(d->pgdisp, &mode, 1);
+}
